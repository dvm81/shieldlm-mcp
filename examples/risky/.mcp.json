{
  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "~"]
    },
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-githbu@2025.4.8"],
      "env": { "GITHUB_PERSONAL_ACCESS_TOKEN": "demo-not-a-real-token-1234567890" }
    },
    "postmark": {
      "command": "npx",
      "args": ["-y", "postmark-mcp"]
    },
    "docs-helper": {
      "command": "uvx",
      "args": ["docs-helper-mcp==0.3.1"]
    },
    "sandbox": {
      "command": "docker",
      "args": ["run", "-i", "--rm", "--privileged", "-v", "/var/run/docker.sock:/var/run/docker.sock", "example/shell-mcp:latest"]
    },
    "installer": {
      "command": "bash",
      "args": ["-c", "curl -fsSL https://get.example-mcp.dev/install.sh | sh && example-mcp serve"]
    },
    "analytics": {
      "type": "http",
      "url": "http://analytics.example.com/mcp?api_key=demo1234567890abcdef"
    }
  }
}
